{% extends '_default/page.html.twig' %}

{% block content %}
  <section class="hero">
    <div class="hero-copy">
      <p class="eyebrow">La maison, tout simplement</p>
      <h1>Des objets choisis.<br><em>Des instants qui restent.</em></h1>
      <p class="hero-intro">Une sélection de pièces sincères et intemporelles pour faire de chaque maison un lieu où l'on se sent bien.</p>
      <a class="button button-dark" href="#selection">Découvrir la collection <span aria-hidden="true">↗</span></a>
      <div class="hero-note"><span class="hero-note-mark" aria-hidden="true">✳</span> Matières naturelles, fabrication raisonnée</div>
    </div>
    <div class="hero-image">
      <img src="https://images.unsplash.com/photo-1600210492486-724fe5c67fb0?auto=format&amp;fit=crop&amp;w=1400&amp;q=85" alt="Salon chaleureux aux matières naturelles et aux tons doux" fetchpriority="high">
      <span class="image-caption">Le calme commence chez soi.</span>
    </div>
  </section>

  <section class="service-strip" aria-label="Nos engagements">
    <p><span aria-hidden="true">✦</span> Petites séries sélectionnées avec soin</p>
    <p><span aria-hidden="true">↗</span> Livraison offerte dès 80 €</p>
    <p><span aria-hidden="true">♡</span> Emballages sans plastique</p>
  </section>

  <section class="collection section-wrap" id="selection">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Nos coups de cœur</p>
        <h2>La sélection du moment</h2>
      </div>
      <a class="text-link" href="{{ url('/boutique/') }}">Voir toute la boutique <span aria-hidden="true">→</span></a>
    </div>
    <div class="product-grid">
      <article class="product-card">
        <div class="product-image">
          <img src="https://images.unsplash.com/photo-1616486338812-3dadae4b4ace?auto=format&amp;fit=crop&amp;w=900&amp;q=80" alt="Intérieur lumineux décoré de matières naturelles" loading="lazy">
          <span class="product-tag">Coup de cœur</span>
        </div>
        <div class="product-info">
          <div><h3>Vase Sillage</h3><p>Céramique artisanale · Écru</p></div>
          <strong>38 €</strong>
        </div>
        <button class="add-to-cart" type="button" data-product="Vase Sillage" data-price="38">Ajouter au panier</button>
      </article>
      <article class="product-card">
        <div class="product-image">
          <img src="https://images.unsplash.com/photo-1618221195710-dd6b41faaea6?auto=format&amp;fit=crop&amp;w=900&amp;q=80" alt="Salon élégant aux textures douces et tons neutres" loading="lazy">
          <span class="product-tag product-tag-light">Matière naturelle</span>
        </div>
        <div class="product-info">
          <div><h3>Lampe Aube</h3><p>Lin & bois de frêne</p></div>
          <strong>74 €</strong>
        </div>
        <button class="add-to-cart" type="button" data-product="Lampe Aube" data-price="74">Ajouter au panier</button>
      </article>
      <article class="product-card">
        <div class="product-image">
          <img src="https://images.unsplash.com/photo-1616486029423-aaa4789e8c9a?auto=format&amp;fit=crop&amp;w=900&amp;q=80" alt="Détail d'une décoration intérieure contemporaine" loading="lazy">
          <span class="product-tag">Petite série</span>
        </div>
        <div class="product-info">
          <div><h3>Plateau Terre</h3><p>Bois sculpté · Fait main</p></div>
          <strong>29 €</strong>
        </div>
        <button class="add-to-cart" type="button" data-product="Plateau Terre" data-price="29">Ajouter au panier</button>
      </article>
    </div>
  </section>

  <section class="story-band">
    <div class="story-image">
      <img src="https://images.unsplash.com/photo-1615874959474-d609969a20ed?auto=format&amp;fit=crop&amp;w=1200&amp;q=85" alt="Coin de vie paisible avec des matières naturelles" loading="lazy">
    </div>
    <div class="story-copy">
      <p class="eyebrow">Moins, mais mieux</p>
      <h2>Une maison qui vous ressemble, sans en faire trop.</h2>
      <p>Nous croyons aux belles matières, aux gestes bien faits et aux objets que l'on garde longtemps. Chaque pièce est choisie pour sa simplicité et sa capacité à rendre le quotidien plus doux.</p>
      <a class="text-link" href="{{ url('/histoire/') }}">En savoir plus sur notre démarche <span aria-hidden="true">→</span></a>
    </div>
  </section>

  <section class="newsletter section-wrap">
    <div>
      <p class="eyebrow">Une lettre de temps en temps</p>
      <h2>De belles idées pour la maison.</h2>
      <p>Écrivez-nous pour recevoir nos nouveautés et conseils déco.</p>
    </div>
    <a class="button button-light" href="{{ url('/contact/') }}">Nous écrire <span aria-hidden="true">↗</span></a>
  </section>
{% endblock %}
